# splunk_dashboards_searches_reference
# all spl searches are documented in english and use snake_case naming.
# ui labels in dashboard json files are in italian.

############################################################
# 00) base macros (copy/paste patterns)
############################################################

# base_flusso_search
# purpose: canonical base search with common token filters.
# expected tokens:
#   tok_index, tok_sourcetype, tok_user_id, tok_browser_type,
#   tok_category, tok_has_error, tok_completed
index=$tok_index$ sourcetype=$tok_sourcetype$
| where ("$tok_user_id$"="*" OR userId="$tok_user_id$")
| where ("$tok_browser_type$"="*" OR browserType="$tok_browser_type$")
| where ("$tok_has_error$"="*" OR tostring(hasError)="$tok_has_error$")
| where ("$tok_completed$"="*" OR tostring(completed)="$tok_completed$")
| where ("$tok_category$"="*" OR mvfind(categories, "$tok_category$") >= 0)

# base_step_expand_search
# purpose: expands nested steps[] into one row per step.
index=$tok_index$ sourcetype=$tok_sourcetype$
| where ("$tok_user_id$"="*" OR userId="$tok_user_id$")
| spath path=steps{} output=step_obj
| mvexpand step_obj
| spath input=step_obj path=stepIndex output=step_index
| spath input=step_obj path=stepLabel output=step_label
| spath input=step_obj path=pagina output=step_page
| spath input=step_obj path=actionCount output=step_action_count
| spath input=step_obj path=firstStartTime output=step_first_start_ms
| spath input=step_obj path=lastEndTime output=step_last_end_ms
| eval step_index=tonumber(step_index), step_action_count=tonumber(step_action_count)

# base_action_expand_search
# purpose: expands nested steps[].actions[] into one row per action.
index=$tok_index$ sourcetype=$tok_sourcetype$
| where ("$tok_user_id$"="*" OR userId="$tok_user_id$")
| spath path=steps{} output=step_obj
| mvexpand step_obj
| spath input=step_obj path=stepIndex output=step_index
| spath input=step_obj path=stepLabel output=step_label
| spath input=step_obj path=actions{} output=action_obj
| mvexpand action_obj
| spath input=action_obj path=seq output=action_seq
| spath input=action_obj path=sessionId output=action_session_id
| spath input=action_obj path=actionType output=action_type
| spath input=action_obj path=actionKey output=action_key
| spath input=action_obj path=startTime output=action_start_ms
| spath input=action_obj path=duration output=action_duration_ms
| eval step_index=tonumber(step_index), action_seq=tonumber(action_seq), action_duration_ms=tonumber(action_duration_ms)

############################################################
# 10) overview searches
############################################################

# kpi_global
index=$tok_index$ sourcetype=$tok_sourcetype$
| where ("$tok_user_id$"="*" OR userId="$tok_user_id$")
| where ("$tok_browser_type$"="*" OR browserType="$tok_browser_type$")
| where ("$tok_category$"="*" OR mvfind(categories, "$tok_category$") >= 0)
| stats
    count as total_flussi
    sum(eval(if(completed,1,0))) as total_completed
    sum(eval(if(abandoned,1,0))) as total_abandoned
    sum(eval(if(hasError,1,0))) as total_with_error
    avg(durationSeconds) as avg_duration_s
    perc50(durationSeconds) as p50_duration_s
    perc95(durationSeconds) as p95_duration_s
| eval completion_rate=round(total_completed/total_flussi*100,2)
| eval abandonment_rate=round(total_abandoned/total_flussi*100,2)
| eval error_rate=round(total_with_error/total_flussi*100,2)

# trend_flussi_completion
index=$tok_index$ sourcetype=$tok_sourcetype$
| timechart span=$tok_time_span$
    count as flussi
    sum(eval(if(completed,1,0))) as completati
    sum(eval(if(hasError,1,0))) as con_errori

# distribution_max_step
index=$tok_index$ sourcetype=$tok_sourcetype$
| stats count as flussi by maxStep
| sort maxStep

# category_mix
index=$tok_index$ sourcetype=$tok_sourcetype$
| mvexpand categories
| stats count as flussi by categories
| sort - flussi

# browser_mix
index=$tok_index$ sourcetype=$tok_sourcetype$
| stats
    count as flussi
    sum(eval(if(completed,1,0))) as completati
  by browserType
| eval completion_rate=round(completati/flussi*100,2)
| sort - flussi

############################################################
# 20) performance and dropout searches
############################################################

# performance_percentiles
index=$tok_index$ sourcetype=$tok_sourcetype$
| stats
    avg(durationSeconds) as avg_duration_s
    perc50(durationSeconds) as p50_duration_s
    perc95(durationSeconds) as p95_duration_s
    avg(activeSeconds) as avg_active_s
    avg(deadTimeSeconds) as avg_dead_s
    avg(totalErrors) as avg_total_errors
    sum(eval(if(hasError,1,0))) as flussi_with_error
    count as total_flussi
| eval error_rate=round(flussi_with_error/total_flussi*100,2)
| eval p50_duration_s=round(p50_duration_s,2), p95_duration_s=round(p95_duration_s,2), avg_dead_s=round(avg_dead_s,2)

# duration_distribution
index=$tok_index$ sourcetype=$tok_sourcetype$
| bin durationSeconds span=10
| stats count as flussi by durationSeconds
| sort durationSeconds

# completion_by_browser
index=$tok_index$ sourcetype=$tok_sourcetype$
| stats
    count as total_flussi
    sum(eval(if(completed,1,0))) as completed_flussi
    avg(durationSeconds) as avg_duration_s
    perc95(durationSeconds) as p95_duration_s
  by browserType
| eval completion_rate=round(completed_flussi/total_flussi*100,2)
| eval avg_duration_s=round(avg_duration_s,2), p95_duration_s=round(p95_duration_s,2)
| sort - total_flussi

# dropout_by_max_step
# note: the dashboard column chart uses this search as drilldown source and
# publishes the clicked maxStep value into tok_step_index.
index=$tok_index$ sourcetype=$tok_sourcetype$
| stats count as flussi by maxStep
| eventstats sum(flussi) as total_flussi
| eval pct_total=round(flussi/total_flussi*100,2)
| sort maxStep
| fields maxStep flussi pct_total

# step_arrivals_and_dropout
index=$tok_index$ sourcetype=$tok_sourcetype$
| stats count as flussi by maxStep
| appendpipe [
    stats sum(flussi) as total
    | eval maxStep=0
    | eval flussi=total
    | fields maxStep flussi
  ]
| sort maxStep
| streamstats current=f window=1 last(flussi) as prev_flussi
| eval step_arrivals=coalesce(prev_flussi, flussi)
| eval step_dropout=step_arrivals-flussi
| eval step_dropout=if(step_dropout<0,0,step_dropout)
| eval dropout_rate=round(step_dropout/step_arrivals*100,2)
| where maxStep>0
| table maxStep step_arrivals flussi step_dropout dropout_rate

# flusso_list_by_max_step
# purpose: detail search paired with dropout_by_max_step; lists the flussi that
# stopped at the step selected through tok_step_index.
index=$tok_index$ sourcetype=$tok_sourcetype$
| where ("$tok_user_id$"="*" OR userId="$tok_user_id$")
| where ("$tok_step_index$"="*" OR tostring(maxStep)="$tok_step_index$")
| table _time flussoId userId maxStep nSteps durationSeconds activeSeconds deadTimeSeconds totalErrors hasError browserType
| sort - durationSeconds

############################################################
# 30) detail and drilldown searches
############################################################

# flusso_detail_table
index=$tok_index$ sourcetype=$tok_sourcetype$
| where ("$tok_flusso_id$"="*" OR flussoId="$tok_flusso_id$")
| where ("$tok_user_id$"="*" OR userId="$tok_user_id$")
| eval session_count=mvcount(sessionIds)
| table _time flussoId userId completed abandoned maxStep nSteps durationSeconds activeSeconds deadTimeSeconds totalErrors hasError session_count browserType country city
| sort - _time

# step_detail_by_flusso
index=$tok_index$ sourcetype=$tok_sourcetype$
| where ("$tok_flusso_id$"="*" OR flussoId="$tok_flusso_id$")
| spath path=steps{} output=step_obj
| mvexpand step_obj
| spath input=step_obj path=stepIndex output=step_index
| spath input=step_obj path=stepLabel output=step_label
| spath input=step_obj path=pagina output=step_page
| spath input=step_obj path=actionCount output=step_action_count
| spath input=step_obj path=firstStartTime output=step_first_start_ms
| spath input=step_obj path=lastEndTime output=step_last_end_ms
| eval step_index=tonumber(step_index)
| where ("$tok_step_index$"="*" OR tostring(step_index)="$tok_step_index$")
| eval step_first_start=strftime(step_first_start_ms/1000, "%Y-%m-%d %H:%M:%S")
| eval step_last_end=strftime(step_last_end_ms/1000, "%Y-%m-%d %H:%M:%S")
| table flussoId userId step_index step_label step_page step_action_count step_first_start step_last_end
| sort step_index

# action_detail_by_flusso_and_step
index=$tok_index$ sourcetype=$tok_sourcetype$
| where ("$tok_flusso_id$"="*" OR flussoId="$tok_flusso_id$")
| spath path=steps{} output=step_obj
| mvexpand step_obj
| spath input=step_obj path=stepIndex output=step_index
| spath input=step_obj path=stepLabel output=step_label
| where ("$tok_step_index$"="*" OR tostring(step_index)="$tok_step_index$")
| spath input=step_obj path=actions{} output=action_obj
| mvexpand action_obj
| spath input=action_obj path=seq output=action_seq
| spath input=action_obj path=sessionId output=action_session_id
| spath input=action_obj path=actionType output=action_type
| spath input=action_obj path=actionKey output=action_key
| spath input=action_obj path=startTime output=action_start_ms
| spath input=action_obj path=duration output=action_duration_ms
| eval action_seq=tonumber(action_seq), action_duration_ms=tonumber(action_duration_ms)
| eval action_start=strftime(action_start_ms/1000, "%Y-%m-%d %H:%M:%S")
| table flussoId step_index step_label action_seq action_session_id action_type action_key action_start action_duration_ms
| sort action_seq

# session_focus_by_flusso
# purpose: lists the dtrum sessions that contributed actions to the flusso,
# so the raw session can be opened in dynatrace or in a raw splunk index.
index=$tok_index$ sourcetype=$tok_sourcetype$
| where ("$tok_flusso_id$"="*" OR flussoId="$tok_flusso_id$")
| spath path=steps{} output=step_obj
| mvexpand step_obj
| spath input=step_obj path=actions{} output=action_obj
| mvexpand action_obj
| spath input=action_obj path=sessionId output=session_id
| stats count as action_events min(_time) as first_event max(_time) as last_event by session_id
| eval first_event=strftime(first_event, "%Y-%m-%d %H:%M:%S")
| eval last_event=strftime(last_event, "%Y-%m-%d %H:%M:%S")
| sort - action_events

# raw_dtrum_investigation_stub (optional external correlation)
# replace <raw_index_name> and key logic according to your Splunk raw dtrum ingestion.
index=<raw_index_name> earliest=$earliest$ latest=$latest$
| search userId="$tok_user_id$"
| table _time userId sessionId actionName actionType targetUrl duration requestErrorCount javascriptErrorCount

