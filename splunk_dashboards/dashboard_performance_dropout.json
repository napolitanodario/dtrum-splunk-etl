{
  "title": "Performance e Dropout Funnel",
  "description": "Analisi delle performance, della qualita e dei punti di uscita del funnel.",
  "inputs": {
    "input_timerange": {
      "type": "input.timerange",
      "title": "Intervallo temporale",
      "options": {
        "token": "tok_timerange",
        "defaultValue": "-7d@d,now"
      }
    },
    "input_user_id": {
      "type": "input.text",
      "title": "User ID",
      "options": {
        "token": "tok_user_id",
        "defaultValue": "*"
      }
    },
    "input_has_error": {
      "type": "input.dropdown",
      "title": "Flussi con errori",
      "options": {
        "token": "tok_has_error",
        "defaultValue": "*",
        "items": [
          { "label": "Tutti", "value": "*" },
          { "label": "Con errori", "value": "true" },
          { "label": "Senza errori", "value": "false" }
        ]
      }
    },
    "input_step_index": {
      "type": "input.dropdown",
      "title": "Step massimo (drilldown)",
      "options": {
        "token": "tok_step_index",
        "defaultValue": "*",
        "items": [
          { "label": "Tutti", "value": "*" },
          { "label": "1", "value": "1" },
          { "label": "2", "value": "2" },
          { "label": "3", "value": "3" },
          { "label": "4", "value": "4" },
          { "label": "5", "value": "5" },
          { "label": "6", "value": "6" },
          { "label": "7", "value": "7" },
          { "label": "8", "value": "8" },
          { "label": "9", "value": "9" }
        ]
      }
    }
  },
  "defaults": {
    "dataSources": {
      "ds.search": {
        "options": {
          "queryParameters": {
            "earliest": "$tok_timerange.earliest$",
            "latest": "$tok_timerange.latest$"
          }
        }
      }
    }
  },
  "dataSources": {
    "ds_perf_kpi": {
      "type": "ds.search",
      "name": "performance_kpi",
      "options": {
        "query": "index=idx_funnel_events sourcetype=dtrum:funnel:flusso\n| where (\"$tok_user_id$\"=\"*\" OR userId=\"$tok_user_id$\")\n| where (\"$tok_has_error$\"=\"*\" OR tostring(hasError)=\"$tok_has_error$\")\n| stats avg(durationSeconds) as avg_duration_s perc50(durationSeconds) as p50_duration_s perc95(durationSeconds) as p95_duration_s avg(activeSeconds) as avg_active_s avg(deadTimeSeconds) as avg_dead_s avg(totalErrors) as avg_total_errors sum(eval(if(hasError,1,0))) as flussi_with_error count as total_flussi\n| eval error_rate=round(flussi_with_error/total_flussi*100,2)\n| eval p50_duration_s=round(p50_duration_s,2), p95_duration_s=round(p95_duration_s,2), avg_dead_s=round(avg_dead_s,2)"
      }
    },
    "ds_duration_distribution": {
      "type": "ds.search",
      "name": "duration_distribution",
      "options": {
        "query": "index=idx_funnel_events sourcetype=dtrum:funnel:flusso\n| where (\"$tok_user_id$\"=\"*\" OR userId=\"$tok_user_id$\")\n| where (\"$tok_has_error$\"=\"*\" OR tostring(hasError)=\"$tok_has_error$\")\n| bin durationSeconds span=10\n| stats count as flussi by durationSeconds\n| sort durationSeconds"
      }
    },
    "ds_completion_browser": {
      "type": "ds.search",
      "name": "completion_by_browser",
      "options": {
        "query": "index=idx_funnel_events sourcetype=dtrum:funnel:flusso\n| where (\"$tok_user_id$\"=\"*\" OR userId=\"$tok_user_id$\")\n| stats count as total_flussi sum(eval(if(completed,1,0))) as completed_flussi avg(durationSeconds) as avg_duration_s perc95(durationSeconds) as p95_duration_s by browserType\n| eval completion_rate=round(completed_flussi/total_flussi*100,2)\n| eval avg_duration_s=round(avg_duration_s,2), p95_duration_s=round(p95_duration_s,2)\n| sort - total_flussi"
      }
    },
    "ds_dropout_max_step": {
      "type": "ds.search",
      "name": "dropout_by_max_step",
      "options": {
        "query": "index=idx_funnel_events sourcetype=dtrum:funnel:flusso\n| where (\"$tok_user_id$\"=\"*\" OR userId=\"$tok_user_id$\")\n| stats count as flussi by maxStep\n| eventstats sum(flussi) as total_flussi\n| eval pct_total=round(flussi/total_flussi*100,2)\n| sort maxStep\n| fields maxStep flussi pct_total"
      }
    },
    "ds_step_waterfall": {
      "type": "ds.search",
      "name": "step_waterfall",
      "options": {
        "query": "index=idx_funnel_events sourcetype=dtrum:funnel:flusso\n| where (\"$tok_user_id$\"=\"*\" OR userId=\"$tok_user_id$\")\n| stats count as flussi by maxStep\n| appendpipe [ stats sum(flussi) as total | eval maxStep=0, flussi=total | fields maxStep flussi ]\n| sort maxStep\n| streamstats current=f window=1 last(flussi) as prev_flussi\n| eval step_arrivals=coalesce(prev_flussi, flussi)\n| eval step_dropout=step_arrivals-flussi\n| eval step_dropout=if(step_dropout<0,0,step_dropout)\n| eval dropout_rate=round(step_dropout/step_arrivals*100,2)\n| where maxStep>0\n| table maxStep step_arrivals flussi step_dropout dropout_rate"
      }
    },
    "ds_error_duration_trend": {
      "type": "ds.search",
      "name": "error_duration_trend",
      "options": {
        "query": "index=idx_funnel_events sourcetype=dtrum:funnel:flusso\n| where (\"$tok_user_id$\"=\"*\" OR userId=\"$tok_user_id$\")\n| timechart span=1d avg(durationSeconds) as avg_duration_s by hasError"
      }
    },
    "ds_step_detail_drill": {
      "type": "ds.search",
      "name": "step_detail_drilldown",
      "options": {
        "query": "index=idx_funnel_events sourcetype=dtrum:funnel:flusso\n| where (\"$tok_user_id$\"=\"*\" OR userId=\"$tok_user_id$\")\n| where (\"$tok_step_index$\"=\"*\" OR tostring(maxStep)=\"$tok_step_index$\")\n| table _time flussoId userId maxStep nSteps durationSeconds activeSeconds deadTimeSeconds totalErrors hasError browserType\n| sort - durationSeconds"
      }
    }
  },
  "visualizations": {
    "viz_p50_duration": {
      "type": "splunk.singlevalue",
      "title": "P50 Durata",
      "dataSources": { "primary": "ds_perf_kpi" },
      "options": {
        "majorValue": "> primary | seriesByName('p50_duration_s') | lastPoint()",
        "unit": "s",
        "unitPosition": "after"
      }
    },
    "viz_p95_duration": {
      "type": "splunk.singlevalue",
      "title": "P95 Durata",
      "dataSources": { "primary": "ds_perf_kpi" },
      "options": {
        "majorValue": "> primary | seriesByName('p95_duration_s') | lastPoint()",
        "unit": "s",
        "unitPosition": "after"
      }
    },
    "viz_avg_dead": {
      "type": "splunk.singlevalue",
      "title": "Dead Time Medio",
      "dataSources": { "primary": "ds_perf_kpi" },
      "options": {
        "majorValue": "> primary | seriesByName('avg_dead_s') | lastPoint()",
        "unit": "s",
        "unitPosition": "after"
      }
    },
    "viz_error_rate": {
      "type": "splunk.singlevalue",
      "title": "Error Rate",
      "dataSources": { "primary": "ds_perf_kpi" },
      "options": {
        "majorValue": "> primary | seriesByName('error_rate') | lastPoint()",
        "unit": "%",
        "unitPosition": "after"
      }
    },
    "viz_duration_distribution": {
      "type": "splunk.column",
      "title": "Distribuzione Durata Flusso (bucket 10s)",
      "dataSources": { "primary": "ds_duration_distribution" },
      "options": {
        "xAxisTitleText": "Durata (s)",
        "yAxisTitleText": "Numero flussi"
      }
    },
    "viz_completion_browser": {
      "type": "splunk.table",
      "title": "Completamento e Latenza per Browser",
      "dataSources": { "primary": "ds_completion_browser" }
    },
    "viz_dropout_step": {
      "type": "splunk.column",
      "title": "Uscite per Step Massimo (clic per drilldown)",
      "dataSources": { "primary": "ds_dropout_max_step" },
      "options": {
        "xAxisTitleText": "Step massimo",
        "yAxisTitleText": "Numero flussi"
      },
      "eventHandlers": [
        {
          "type": "drilldown.setToken",
          "options": {
            "tokens": [
              { "token": "tok_step_index", "key": "row.maxStep.value" }
            ]
          }
        }
      ]
    },
    "viz_step_waterfall": {
      "type": "splunk.table",
      "title": "Arrivi e Abbandoni per Step",
      "dataSources": { "primary": "ds_step_waterfall" },
      "eventHandlers": [
        {
          "type": "drilldown.setToken",
          "options": {
            "tokens": [
              { "token": "tok_step_index", "key": "row.maxStep.value" }
            ]
          }
        }
      ]
    },
    "viz_error_duration_trend": {
      "type": "splunk.line",
      "title": "Trend Durata Media con e senza Errori",
      "dataSources": { "primary": "ds_error_duration_trend" },
      "options": {
        "legendDisplay": "bottom",
        "xAxisTitleText": "Data",
        "yAxisTitleText": "Durata media (s)"
      }
    },
    "viz_step_detail_drill": {
      "type": "splunk.table",
      "title": "Flussi dello Step Selezionato",
      "dataSources": { "primary": "ds_step_detail_drill" }
    }
  },
  "layout": {
    "globalInputs": [
      "input_timerange",
      "input_user_id",
      "input_has_error",
      "input_step_index"
    ],
    "tabs": {
      "items": [
        { "label": "Performance e Dropout", "layoutId": "layout_performance" }
      ]
    },
    "layoutDefinitions": {
      "layout_performance": {
        "type": "grid",
        "options": {
          "width": 1200,
          "height": 1500,
          "display": "auto"
        },
        "structure": [
          { "item": "viz_p50_duration", "type": "block", "position": { "x": 0, "y": 0, "w": 300, "h": 180 } },
          { "item": "viz_p95_duration", "type": "block", "position": { "x": 300, "y": 0, "w": 300, "h": 180 } },
          { "item": "viz_avg_dead", "type": "block", "position": { "x": 600, "y": 0, "w": 300, "h": 180 } },
          { "item": "viz_error_rate", "type": "block", "position": { "x": 900, "y": 0, "w": 300, "h": 180 } },
          { "item": "viz_duration_distribution", "type": "block", "position": { "x": 0, "y": 180, "w": 600, "h": 300 } },
          { "item": "viz_completion_browser", "type": "block", "position": { "x": 600, "y": 180, "w": 600, "h": 300 } },
          { "item": "viz_dropout_step", "type": "block", "position": { "x": 0, "y": 480, "w": 600, "h": 300 } },
          { "item": "viz_step_waterfall", "type": "block", "position": { "x": 600, "y": 480, "w": 600, "h": 300 } },
          { "item": "viz_error_duration_trend", "type": "block", "position": { "x": 0, "y": 780, "w": 1200, "h": 300 } },
          { "item": "viz_step_detail_drill", "type": "block", "position": { "x": 0, "y": 1080, "w": 1200, "h": 340 } }
        ]
      }
    }
  }
}
