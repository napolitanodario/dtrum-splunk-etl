{
  "title": "Panoramica Funnel Flussi",
  "description": "Dashboard di overview dei flussi (schema v2) con KPI, trend e distribuzioni principali.",
  "inputs": {
    "input_timerange": {
      "type": "input.timerange",
      "title": "Intervallo temporale",
      "options": {
        "token": "tok_timerange",
        "defaultValue": "-7d@d,now"
      }
    },
    "input_user_id": {
      "type": "input.text",
      "title": "User ID",
      "options": {
        "token": "tok_user_id",
        "defaultValue": "*"
      }
    },
    "input_browser_type": {
      "type": "input.dropdown",
      "title": "Browser",
      "options": {
        "token": "tok_browser_type",
        "defaultValue": "*",
        "items": [
          { "label": "Tutti", "value": "*" },
          { "label": "Chrome", "value": "Chrome" },
          { "label": "Edge", "value": "Edge" },
          { "label": "Firefox", "value": "Firefox" },
          { "label": "Safari", "value": "Safari" }
        ]
      }
    },
    "input_category": {
      "type": "input.text",
      "title": "Categoria",
      "options": {
        "token": "tok_category",
        "defaultValue": "*"
      }
    }
  },
  "defaults": {
    "dataSources": {
      "ds.search": {
        "options": {
          "queryParameters": {
            "earliest": "$tok_timerange.earliest$",
            "latest": "$tok_timerange.latest$"
          }
        }
      }
    }
  },
  "dataSources": {
    "ds_kpi_global": {
      "type": "ds.search",
      "name": "kpi_global",
      "options": {
        "query": "index=idx_funnel_events sourcetype=dtrum:funnel:flusso\n| where (\"$tok_user_id$\"=\"*\" OR userId=\"$tok_user_id$\")\n| where (\"$tok_browser_type$\"=\"*\" OR browserType=\"$tok_browser_type$\")\n| where (\"$tok_category$\"=\"*\" OR mvfind(categories, \"$tok_category$\") >= 0)\n| stats count as total_flussi sum(eval(if(completed,1,0))) as total_completed sum(eval(if(abandoned,1,0))) as total_abandoned sum(eval(if(hasError,1,0))) as total_with_error avg(durationSeconds) as avg_duration_s perc50(durationSeconds) as p50_duration_s perc95(durationSeconds) as p95_duration_s\n| eval completion_rate=round(total_completed/total_flussi*100,2)\n| eval abandonment_rate=round(total_abandoned/total_flussi*100,2)\n| eval error_rate=round(total_with_error/total_flussi*100,2)"
      }
    },
    "ds_trend_flussi": {
      "type": "ds.search",
      "name": "trend_flussi",
      "options": {
        "query": "index=idx_funnel_events sourcetype=dtrum:funnel:flusso\n| where (\"$tok_user_id$\"=\"*\" OR userId=\"$tok_user_id$\")\n| where (\"$tok_browser_type$\"=\"*\" OR browserType=\"$tok_browser_type$\")\n| timechart span=1d count as flussi sum(eval(if(completed,1,0))) as completati sum(eval(if(hasError,1,0))) as con_errori"
      }
    },
    "ds_max_step": {
      "type": "ds.search",
      "name": "distribution_max_step",
      "options": {
        "query": "index=idx_funnel_events sourcetype=dtrum:funnel:flusso\n| where (\"$tok_user_id$\"=\"*\" OR userId=\"$tok_user_id$\")\n| where (\"$tok_browser_type$\"=\"*\" OR browserType=\"$tok_browser_type$\")\n| stats count as flussi by maxStep\n| sort maxStep"
      }
    },
    "ds_category_mix": {
      "type": "ds.search",
      "name": "category_mix",
      "options": {
        "query": "index=idx_funnel_events sourcetype=dtrum:funnel:flusso\n| where (\"$tok_user_id$\"=\"*\" OR userId=\"$tok_user_id$\")\n| mvexpand categories\n| stats count as flussi by categories\n| sort - flussi"
      }
    },
    "ds_browser_mix": {
      "type": "ds.search",
      "name": "browser_mix",
      "options": {
        "query": "index=idx_funnel_events sourcetype=dtrum:funnel:flusso\n| where (\"$tok_user_id$\"=\"*\" OR userId=\"$tok_user_id$\")\n| stats count as flussi sum(eval(if(completed,1,0))) as completati by browserType\n| eval completion_rate=round(completati/flussi*100,2)\n| sort - flussi"
      }
    }
  },
  "visualizations": {
    "viz_total_flussi": {
      "type": "splunk.singlevalue",
      "title": "Flussi Totali",
      "dataSources": { "primary": "ds_kpi_global" },
      "options": {
        "majorValue": "> primary | seriesByName('total_flussi') | lastPoint()"
      }
    },
    "viz_completion_rate": {
      "type": "splunk.singlevalue",
      "title": "Tasso di Completamento",
      "dataSources": { "primary": "ds_kpi_global" },
      "options": {
        "majorValue": "> primary | seriesByName('completion_rate') | lastPoint()",
        "unit": "%",
        "unitPosition": "after"
      }
    },
    "viz_error_rate": {
      "type": "splunk.singlevalue",
      "title": "Tasso Errori",
      "dataSources": { "primary": "ds_kpi_global" },
      "options": {
        "majorValue": "> primary | seriesByName('error_rate') | lastPoint()",
        "unit": "%",
        "unitPosition": "after"
      }
    },
    "viz_p95_duration": {
      "type": "splunk.singlevalue",
      "title": "P95 Durata Flusso",
      "dataSources": { "primary": "ds_kpi_global" },
      "options": {
        "majorValue": "> primary | seriesByName('p95_duration_s') | lastPoint()",
        "unit": "s",
        "unitPosition": "after"
      }
    },
    "viz_trend_flussi": {
      "type": "splunk.line",
      "title": "Trend Flussi, Completati e Con Errori",
      "dataSources": { "primary": "ds_trend_flussi" },
      "options": {
        "legendDisplay": "bottom",
        "xAxisTitleText": "Data",
        "yAxisTitleText": "Numero flussi"
      }
    },
    "viz_max_step": {
      "type": "splunk.column",
      "title": "Distribuzione per Step Massimo Raggiunto",
      "dataSources": { "primary": "ds_max_step" },
      "options": {
        "xAxisTitleText": "Step massimo",
        "yAxisTitleText": "Numero flussi"
      }
    },
    "viz_category_mix": {
      "type": "splunk.pie",
      "title": "Mix Categorie Prodotto",
      "dataSources": { "primary": "ds_category_mix" },
      "options": {
        "showDonutHole": true
      }
    },
    "viz_browser_mix": {
      "type": "splunk.table",
      "title": "Distribuzione e Completamento per Browser",
      "dataSources": { "primary": "ds_browser_mix" }
    }
  },
  "layout": {
    "globalInputs": [
      "input_timerange",
      "input_user_id",
      "input_browser_type",
      "input_category"
    ],
    "tabs": {
      "items": [
        { "label": "Panoramica", "layoutId": "layout_overview" }
      ]
    },
    "layoutDefinitions": {
      "layout_overview": {
        "type": "grid",
        "options": {
          "width": 1200,
          "height": 1100,
          "display": "auto"
        },
        "structure": [
          { "item": "viz_total_flussi", "type": "block", "position": { "x": 0, "y": 0, "w": 300, "h": 180 } },
          { "item": "viz_completion_rate", "type": "block", "position": { "x": 300, "y": 0, "w": 300, "h": 180 } },
          { "item": "viz_error_rate", "type": "block", "position": { "x": 600, "y": 0, "w": 300, "h": 180 } },
          { "item": "viz_p95_duration", "type": "block", "position": { "x": 900, "y": 0, "w": 300, "h": 180 } },
          { "item": "viz_trend_flussi", "type": "block", "position": { "x": 0, "y": 180, "w": 800, "h": 320 } },
          { "item": "viz_max_step", "type": "block", "position": { "x": 800, "y": 180, "w": 400, "h": 320 } },
          { "item": "viz_category_mix", "type": "block", "position": { "x": 0, "y": 500, "w": 600, "h": 320 } },
          { "item": "viz_browser_mix", "type": "block", "position": { "x": 600, "y": 500, "w": 600, "h": 320 } }
        ]
      }
    }
  }
}
